GITHUB_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=
REVIEW_ACCESS_KEY=
# Defina como 1 para abrir o site sem login (mesmo com GITHUB_TOKEN).
# Nesse modo, só os repositórios abaixo recebem comentários do token
# (donos ou dono/repo, separados por vírgula; padrão: gi-a-dias).
ACESSO_ABERTO=
REPOS_COMENTARIO=
# Endereços do front-end autorizados a chamar a API (separe por vírgula).
# Em produção, coloque a URL onde o front estiver hospedado.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Defina como 1 para a própria API servir a pasta frontend/ (um deploy só).
SERVIR_FRONTEND=

# Integração com o Módulo 6 (Central de Notificações).
# A chave é secreta: vem do Módulo 6 e nunca vai para o código ou o GitHub.
NOTIFICACOES_KEY=
# Opcional: projeto padrão (ID real do Módulo 1) para as notificações.
NOTIFICACOES_PROJECT_ID=
# Opcional: só mude se o Módulo 6 trocar de endereço.
NOTIFICACOES_URL=

# Integração com o Módulo 2 (GitHub Sync): conta da plataforma (Módulo 1)
# usada só para listar os PRs sincronizados. Nunca coloque no código.
MODULO2_EMAIL=
MODULO2_SENHA=
# Opcional: só mude se o Módulo 2 trocar de endereço.
MODULO2_URL=
